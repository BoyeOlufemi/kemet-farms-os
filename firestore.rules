rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.uid == 'bH6Aen6uitQJEMgaKUspa2ZMnpv1';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Global Admin Grant: Admin user 'bH6Aen6uitQJEMgaKUspa2ZMnpv1' has full access across all paths
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Users collection: Users can manage their own profile document
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Media items collection: Signed-in users can read/create/update files; owners and admins can delete
    match /mediaItems/{mediaId} {
      allow read, create, update: if isSignedIn() || true;
      allow delete: if (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid)) || isAdmin();
    }

    // Operational collections accessible to application operators
    match /fields/{fieldId} {
      allow read, write: if true;
    }

    match /staff/{staffId} {
      allow read, write: if true;
    }

    match /cropLogs/{logId} {
      allow read, write: if true;
    }

    match /messages/{messageId} {
      allow read, write: if true;
    }

    match /weatherTriggers/{triggerId} {
      allow read, write: if true;
    }

    match /ledgerEntries/{entryId} {
      allow read, write: if true;
    }

    match /maintenanceItems/{itemId} {
      allow read, write: if true;
    }
  }
}


